    "uploaded_zip_source_file_matches_archived_blob": true
  },
  "fukushima_template_constants": {
    "minlatitude": 30.0,
    "maxlatitude": 46.0,
    "minlongitude": 128.0,
    "maxlongitude": 146.0,
    "seismic_load_minmagnitude": 2.0,
    "seismic_energy_formula": "E = 10^(1.5*M + 4.8)",
    "seismic_daily_transform": "log10(sum daily energy) on positive-event days; 0 on verified no-event days",
    "nikkei_ticker": "^N225",
    "nikkei_transform": "daily pct return; 5-observation rolling SD * sqrt(252)",
    "fx_ticker": "JPY=X",
    "fx_transform": "absolute daily pct change"
  },
  "candidate_universe": {
    "query_endpoint": "https://earthquake.usgs.gov/fdsnws/event/1/query",
    "count_endpoint": "https://earthquake.usgs.gov/fdsnws/event/1/count",
    "eventtype": "earthquake",
    "minimum_candidate_magnitude": 7.0,
    "geographic_bounds": {
      "minlatitude": 30.0,
      "maxlatitude": 46.0,
      "minlongitude": 128.0,
      "maxlongitude": 146.0
    },
    "conceptual_date_interval": {
      "timezone": "Asia/Tokyo",
      "start_date_inclusive": "1995-01-01",
      "end_date_inclusive": "2025-06-30"
    },
    "retrieval_utc_envelope": {
      "starttime_inclusive": "1994-12-31T15:00:00Z",
      "endtime_boundary": "2025-06-30T15:00:00Z",
      "post_filter_rule": "Convert each USGS origin timestamp to Asia/Tokyo and retain only JST calendar dates 1995-01-01 through 2025-06-30 inclusive."
    },
    "format": "csv",
    "orderby": "time-asc",
    "limit": 20000,
    "completeness_check": "USGS count endpoint must equal returned CSV row count before filtering.",
    "stored_sort_order": "event_id ascending",
    "manual_additions_permitted": false
