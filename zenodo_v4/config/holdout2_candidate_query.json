  "eligibility_rules_reference": {
    "same_day_cutoff_jst": "15:00",
    "event_date_must_be_common_valid_financial_date": true,
    "required_pre_event_aligned_observations": 250,
    "required_post_event_aligned_observations": 250,
    "fukushima_development_interval_excluded": [
      "2010-06-08",
      "2011-09-29"
    ],
    "prior_project_event_ids_excluded": true,
    "proxy_replacement_permitted": false
  },
  "selection": {
    "seed": 731006,
    "rng": "NumPy Generator(PCG64(SeedSequence([731006])))",
    "draw_rule": "After eligibility is frozen and eligible candidates are sorted by event_id ascending, draw one integer uniformly from [0, N). No redraw based on result."
  }
